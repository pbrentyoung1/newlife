---
import { destination } from "../data/destinations";
import { footerNavigation, primaryNavigation } from "../data/navigation";
import { site } from "../data/site";

const year = new Date().getFullYear();
const facebook = destination("facebook");
const youtube = destination("youtubeChannel");
---

<footer class="site-footer">
  <div class="container-shell footer-grid">
    <div class="footer-identity">
      <p class="wordmark footer-wordmark">{site.name}<small>{site.fullName}</small></p>
      <p>{site.invitation}</p>
      <p class="footer-location">{site.location}</p>
    </div>

    <nav class="footer-links" aria-label="Visitor links">
      <p class="eyebrow">Explore</p>
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <nav class="footer-links" aria-label="More links">
      <p class="eyebrow">New Life</p>
      {footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-links">
      <p class="eyebrow">Elsewhere</p>
      {facebook && <a href={facebook} rel="noreferrer">Facebook</a>}
      {youtube && <a href={youtube} rel="noreferrer">YouTube</a>}
      <a href="/connect/">Church Center</a>
    </div>
  </div>

  <div class="container-shell footer-bottom">
    <p>© {year} {site.fullName}</p>
    <p>{site.launchStatus} · Search indexing is disabled.</p>
  </div>
</footer>
