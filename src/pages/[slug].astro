---
import PageLayout from "../layouts/PageLayout.astro";
import PageContentIndex from "../components/PageContentIndex.astro";
import { sitePages } from "../data/pages";

export function getStaticPaths() {
  return sitePages.map((page) => ({ params: { slug: page.slug }, props: page }));
}

const { eyebrow, title, description, note, tone, sections } = Astro.props;
---

<PageLayout eyebrow={eyebrow} title={title} description={description} note={note} tone={tone}>
  <PageContentIndex sections={sections} tone={tone} />

  <section class="section-shell section-blue page-next-step">
    <div class="container-shell feature-split">
      <div class="stack">
        <p class="eyebrow">While we build</p>
        <h2>Looking for something specific?</h2>
        <p class="lead">The new site is still being prepared. A person can help you find the current information.</p>
      </div>
      <div class="button-row">
        <a class="button button-on-dark" href="/contact/">Ask a question</a>
        <a class="button-secondary button-on-dark" href="/">Return home</a>
      </div>
    </div>
  </section>
</PageLayout>
